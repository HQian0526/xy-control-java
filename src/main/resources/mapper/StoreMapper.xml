<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN"
        "http://mybatis.org/dtd/mybatis-3-mapper.dtd" >
<mapper namespace="com.example.springboottemplate.mapper.StoreMapper">
    <!-- 定义结果映射 -->
    <resultMap id="storeResultMap" type="Store">
        <id property="id" column="id"/> <!-- 主键字段 -->
        <result property="storeId" column="store_id"/>
        <result property="realName" column="real_name"/>
        <result property="storeName" column="store_name"/>
        <result property="avatar" column="avatar"/>
        <result property="address" column="address"/>
        <result property="userId" column="user_id"/>
        <result property="storeType" column="store_type"/>
        <result property="storeStatus" column="store_status"/>
        <result property="businessHours" column="business_hours"/>
        <result property="closedUntil" column="closed_until"/>
        <result property="openUntil" column="open_until"/>
        <result property="deliveryFee" column="delivery_fee"/>
        <result property="storeTime" column="store_time"/>
        <result property="expired" column="expired"/>
        <result property="shopStatus" column="shop_status"/>
        <result property="identityName" column="identity_name"/>
        <result property="identityCompanyName" column="identity_company_name"/>
        <result property="businessLicense" column="business_license" />
        <result property="identityNo" column="identity_no"/>
        <result property="identityPhoto" column="identity_photo"/>
        <result property="identityPhone" column="identity_phone"/>
        <result property="identityEmail" column="identity_email"/>
        <result property="createdTime" column="created_time"/>
        <result property="createdBy" column="created_by"/>
        <result property="updateTime" column="update_time"/>
        <result property="updateBy" column="update_by"/>
        <result property="remark" column="remark"/>
        <result property="miniappType" column="miniapp_type"/>
        <result property="showStock" column="show_stock"/>
        <result property="showAddress" column="show_address"/>
        <result property="showQuantity" column="show_quantity"/>
        <result property="showCart" column="show_cart"/>
        <result property="orderBtnText" column="order_btn_text"/>
        <result property="enablePay" column="enable_pay"/>
        <result property="enableRecharge" column="enable_recharge"/>
        <result property="homeTabText" column="home_tab_text"/>
        <result property="listBtnText" column="list_btn_text"/>
        <result property="showSaleNum" column="show_sale_num"/>
        <result property="showDeliveryFee" column="show_delivery_fee"/>
        <result property="intro" column="intro"/>
        <result property="contactPhone" column="contact_phone"/>
        <result property="activityNotice" column="activity_notice"/>
        <result property="homeNotice" column="home_notice"/>
        <result property="showHours" column="show_hours"/>
        <result property="showActivity" column="show_activity"/>
        <result property="showContact" column="show_contact"/>
        <result property="showOtherBusiness" column="show_other_business"/>
        <result property="deleted" column="deleted"/>
    </resultMap>

    <insert id="addStore" parameterType="Store">
        INSERT into store (id, store_id, store_name, avatar, address, user_id, store_type, store_status, store_time, expired, shop_status, identity_name, identity_company_name, business_license, identity_no, identity_photo, identity_phone, identity_email, created_time, created_by, remark, deleted)
        value (#{id}, #{storeId}, #{storeName}, #{avatar}, #{address}, #{userId}, #{storeType}, #{storeStatus}, #{storeTime}, #{expired}, #{shopStatus}, #{identityName}, #{identityCompanyName}, #{businessLicense}, #{identityNo}, #{identityPhoto}, #{identityPhone}, #{identityEmail}, #{createdTime}, #{createdBy}, #{remark}, #{deleted})
    </insert>

    <!-- 查询所有商户信息（模糊查询）-->
    <select id="findStore" parameterType="Store" resultMap="storeResultMap">
        select * from store
        <where>
            <if test="id != null">
                and id = #{id}
            </if>
            <if test="storeId != null">
                and store_id = #{storeId}
            </if>
            <if test="userId != null">
                and user_id = #{userId}
            </if>
            <if test="storeName != null and storeName != ''">
                and store_name like CONCAT('%', #{storeName}, '%')
            </if>
            <if test="storeType != null and storeType != ''">
                and store_type = #{storeType}
            </if>
            <if test="storeStatus != null">
                and store_status = #{storeStatus}
            </if>
            <if test="storeTime != null and storeTime != ''">
                and store_time = #{storeTime}
            </if>
            <if test="expired != null">
                and expired = #{expired}
            </if>
            <if test="shopStatus != null">
                and shop_status = #{shopStatus}
            </if>
            <if test="address != null and address != ''">
                and address like CONCAT('%', #{address}, '%')
            </if>
            <if test="identityName != null and identityName != ''">
                and identity_name like CONCAT('%', #{identityName}, '%')
            </if>
            <if test="identityCompanyName != null and identityCompanyName != ''">
                and identity_company_name like CONCAT('%', #{identityCompanyName}, '%')
            </if>
            <if test="identityNo != null and identityNo != ''">
                and identity_no like CONCAT('%', #{identityNo}, '%')
            </if>
            <if test="identityPhone != null and identityPhone != ''">
                and identity_phone like CONCAT('%', #{identityPhone}, '%')
            </if>
            <if test="identityEmail != null and identityEmail != ''">
                and identity_email like CONCAT('%', #{identityEmail}, '%')
            </if>
            <if test="createdTime != null and createdTime != ''">
                and created_time = #{createdTime}
            </if>
            <if test="updateTime != null and updateTime != ''">
                and update_time = #{updateTime}
            </if>
            <choose>
                <when test="deleted != null">
                    and deleted = #{deleted}
                </when>
<!--                <otherwise>-->
<!--                    and deleted = 0-->
<!--                </otherwise>-->
            </choose>
        </where>
    </select>

    <!-- 根据用户ID修改商户信息（store_id 创建后不可改） -->
    <update id="updateStore" parameterType="Store">
        update store
        <set>
            <if test="storeName != null">store_name = #{storeName},</if>
            <if test="avatar != null">avatar = #{avatar},</if>
            <if test="address != null">address = #{address},</if>
            <if test="userId != null">user_id = #{userId},</if>
            <if test="storeType != null">store_type = #{storeType},</if>
            <if test="storeStatus != null">store_status = #{storeStatus},</if>
            <if test="businessHours != null">business_hours = #{businessHours},</if>
            <if test="closedUntil != null">closed_until = #{closedUntil},</if>
            <if test="closedUntilCleared != null and closedUntilCleared">closed_until = null,</if>
            <if test="openUntil != null">open_until = #{openUntil},</if>
            <if test="openUntilCleared != null and openUntilCleared">open_until = null,</if>
            <if test="deliveryFee != null">delivery_fee = #{deliveryFee},</if>
            <if test="storeTime != null">store_time = #{storeTime},</if>
            <if test="storeTimeCleared != null and storeTimeCleared">store_time = null,</if>
            <if test="expired != null">expired = #{expired},</if>
            <if test="shopStatus != null">shop_status = #{shopStatus},</if>
            <if test="miniappType != null">miniapp_type = #{miniappType},</if>
            <if test="showStock != null">show_stock = #{showStock},</if>
            <if test="showAddress != null">show_address = #{showAddress},</if>
            <if test="showQuantity != null">show_quantity = #{showQuantity},</if>
            <if test="showCart != null">show_cart = #{showCart},</if>
            <if test="orderBtnText != null">order_btn_text = #{orderBtnText},</if>
            <if test="enablePay != null">enable_pay = #{enablePay},</if>
            <if test="enableRecharge != null">enable_recharge = #{enableRecharge},</if>
            <if test="homeTabText != null">home_tab_text = #{homeTabText},</if>
            <if test="listBtnText != null">list_btn_text = #{listBtnText},</if>
            <if test="showSaleNum != null">show_sale_num = #{showSaleNum},</if>
            <if test="showDeliveryFee != null">show_delivery_fee = #{showDeliveryFee},</if>
            <if test="intro != null">intro = #{intro},</if>
            <if test="contactPhone != null">contact_phone = #{contactPhone},</if>
            <if test="activityNotice != null">activity_notice = #{activityNotice},</if>
            <if test="homeNotice != null">home_notice = #{homeNotice},</if>
            <if test="showHours != null">show_hours = #{showHours},</if>
            <if test="showActivity != null">show_activity = #{showActivity},</if>
            <if test="showContact != null">show_contact = #{showContact},</if>
            <if test="showOtherBusiness != null">show_other_business = #{showOtherBusiness},</if>
            <if test="identityName != null">identity_name = #{identityName},</if>
            <if test="identityCompanyName != null">identity_company_name = #{identityCompanyName},</if>
            <if test="businessLicense != null">business_license = #{businessLicense},</if>
            <if test="identityNo != null">identity_no = #{identityNo},</if>
            <if test="identityPhoto != null">identity_photo = #{identityPhoto},</if>
            <if test="identityPhone != null">identity_phone = #{identityPhone},</if>
            <if test="identityEmail != null">identity_email = #{identityEmail},</if>
            <if test="updateBy != null">update_by = #{updateBy},</if>
            <if test="remark != null">remark = #{remark},</if>
            <if test="deleted != null">deleted = #{deleted},</if>
        </set>
        where id = #{id}
    </update>

    <!-- 根据用户id查询商户信息-->
    <select id="selectByStoreId" parameterType="java.lang.Long" resultMap="storeResultMap">
        select * from store where store_id = #{storeId}
    </select>
</mapper>